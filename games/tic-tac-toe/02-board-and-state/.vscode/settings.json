//===----------------------------------------------------------------------===//
// settings.json - 棋盘状态工程的编辑器配置
//
// 按当前打开的工作区生效：请把 02-board-and-state/ 目录本身
// 作为 VS Code 工作区打开，配置才会命中本目录。
//===----------------------------------------------------------------------===//
{
  // 通用编辑行为
  "editor.formatOnSave": true,

  // 格式化与补全由 clangd 完成：直接读取本目录 .clang-format，
  // 并从 build/compile_commands.json 定位头文件与编译参数。
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  "[c]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },

  // Python 格式化扩展：首个含 Python 代码的编号目录再配置。

  // 文件排除：不显示 clangd 的缓存目录
  "files.exclude": {
    "**/.cache": true
  }
}
