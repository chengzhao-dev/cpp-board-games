#===--------------------------------------------------------------------------------------------===#
# .clang-format - C++ 格式化规则
#===--------------------------------------------------------------------------------------------===#

# 基础语言与风格：Google 风格；C++23 用 Latest 解析（clang-format 21 不认 c++23）。
BasedOnStyle: Google
Language: Cpp
Standard: Latest

# 行尾：固定 LF，不从文件里推断。
LineEnding: LF

# 行宽：普通代码行限制为 100 列；文件头横幅同为 100 列。
ColumnLimit: 100

# 注释重排：连续 // 与 /// 按 100 列重排。
ReflowComments: true

# 续行对齐：开括号后第一个字符对齐，三元运算符断在 ? 和 : 之前并上下对齐。
AlignAfterOpenBracket: Align
BreakBeforeTernaryOperators: true
AlignOperands: Align

# 缩进与制表符：2 个空格，不输出制表符。
IndentWidth: 2
TabWidth: 2
UseTab: Never

# 类内空白：访问说明符后不空行；属性与声明同一行，缩进跟成员。
AccessModifierOffset: -1
EmptyLineAfterAccessModifier: Never
BreakAfterAttributes: Never

# 短函数与控制流：不压缩成单行，保持代码块边界清楚。
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false

# 留白：最多保留 1 个空行，块首不留空行。
MaxEmptyLinesToKeep: 1
KeepEmptyLinesAtTheStartOfBlocks: false

# include 分组：主头 → C 系统头 → C++ 标准库 → 其他库 → 项目头。
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<gtest/'
    Priority: 3
  - Regex: '^<[^/>]*\.h>'
    Priority: 1
  - Regex: '^<.*>'
    Priority: 2
  - Regex: '.*'
    Priority: 4
