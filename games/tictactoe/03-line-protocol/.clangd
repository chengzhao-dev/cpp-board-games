#===--------------------------------------------------------------------------------------------===#
# .clangd - 编辑器语言服务配置
#===--------------------------------------------------------------------------------------------===#
CompileFlags:
  # 构建后从 build/compile_commands.json 读取真实编译参数。
  CompilationDatabase: build
  # 未生成编译数据库时的解析兜底，与目标的 C++20、libc++ 和警告选项一致。
  Add:
    - -std=c++20
    - -stdlib=libc++
    - -Wall
    - -Wextra
    - -Werror
    # 未构建时的头文件搜索路径，相对本文件所在目录。
    - -Itictactoe/include
    - -Iapps/include

Diagnostics:
  # 补上 clangd 默认未开的命名与 google 检查，与同目录 .clang-tidy 一致。
  ClangTidy:
    Add:
      - readability-identifier-naming
      - google-build-using-namespace
      - google-global-names-in-headers
      - google-explicit-constructor
  # 只压制首次未构建时找不到头文件的噪音；构建后以编译数据库为准。
  Suppress:
    - pp_file_not_found
