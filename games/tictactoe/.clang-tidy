#===--------------------------------------------------------------------------------------------===#
# .clang-tidy - C++ 静态检查与命名规则
#===--------------------------------------------------------------------------------------------===#
---
Checks:
  # 检查族：打开主要检查族；google 检查没有通配符，逐项列出。
  - bugprone-*
  - cppcoreguidelines-*
  - misc-*
  - modernize-*
  - performance-*
  - portability-*
  - readability-*
  - clang-analyzer-core.*
  - google-build-using-namespace
  - google-global-names-in-headers
  - google-explicit-constructor
  - google-readability-casting
  # 参数误报：行与列类型相同，误报多于真问题。
  - "-bugprone-easily-swappable-parameters"
  # 返回类型：函数保持前置写法。
  - "-modernize-use-trailing-return-type"
  # 短名：row、col 是坐标和循环的正常用名。
  - "-readability-identifier-length"
  # 魔法数字：尺寸常量集中定义，不逐个字面量报警。
  - "-readability-magic-numbers"
  # 头文件哨卫：使用路径式 #define 守卫，不用 #pragma once。
CheckOptions:
  # 命名：类型用 CamelCase，变量和参数用 lower_case，常量与枚举子用 k 前缀。
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: CamelCase
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  # 局部常量：不是全程固定的 k 常量，避免误套 ConstantCase。
  - key: readability-identifier-naming.LocalConstantCase
    value: lower_case
  - key: readability-identifier-naming.MemberCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key: readability-identifier-naming.ConstantCase
    value: CamelCase
  - key: readability-identifier-naming.ConstantPrefix
    value: k
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantPrefix
    value: k
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
  # 包含守卫按 Google 规则以 _H_ 结尾，UPPER_CASE 会把它判成多余下划线。
  - key: readability-identifier-naming.MacroDefinitionIgnoredRegexp
    value: '^[A-Z][A-Z0-9_]*_H_$'
