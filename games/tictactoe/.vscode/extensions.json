//===------------------------------------------------------------------------------------------===//
// extensions.json - 井字棋工程的推荐扩展
//
// 只列出推荐，不强制安装；通过 Remote - WSL 打开时，需要访问
// 编译器和源码的扩展会安装在 WSL 远程端。
//===------------------------------------------------------------------------------------------===//
{
  "recommendations": [
    // WSL 与远程开发
    "ms-vscode-remote.remote-wsl",

    // clangd 负责编辑、补全、诊断和格式化；CMake Tools 负责配置、构建、
    // 运行和调试入口；C/C++ 扩展只作为 CMake Debug 的调试后端。
    "llvm-vs-code-extensions.vscode-clangd",
    "ms-vscode.cmake-tools",
    "ms-vscode.cpptools"
  ]
}
