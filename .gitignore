#===--------------------------------------------------------------------------------------------===#
# .gitignore - 仓库不入库的生成物与本地文件
#===--------------------------------------------------------------------------------------------===#

# Quarto 生成物与缓存
/_book/
/.quarto/
**/*.quarto_ipynb
*_files/
/site_libs/

# C++ 与 CMake 产物
build/
*.o
*.obj
a.out
*.exe
CMakeUserPresets.json

# Python 缓存与覆盖率
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
coverage.xml
*.coverage

# 编辑器与操作系统临时文件（仓库根不放 .vscode，编辑器配置只放阶段等子目录内）
/.vscode/
/.idea/
.DS_Store
Thumbs.db
*.local

# 阶段目录里的 IDE 用户文件（settings/extensions 可提交，其余不入库）
.vscode/*.code-workspace
.vscode/launch.json
.vscode/tasks.json
.vscode/*.local.json

# 本地依赖与缓存目录
node_modules/
.tmp/
.cache/

# ZCode 本地计划与临时区
/.zcode/
.zcodeignore

# 临时分析、重构报告与生成产物（不入库）
/temp/
