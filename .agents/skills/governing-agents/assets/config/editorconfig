# 编辑器统一约定：与 .gitattributes（文本 LF、UTF-8）保持一致
# 目的是让「保存即符合仓库格式」，避免 agent 与人工产生行尾/BOM 噪声 diff
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# C / C++ / CMake：缩进取 2，与 .clang-format 的 IndentWidth 对齐
[*.{c,cc,cpp,h,hh,hpp,cu}]
indent_size = 2

[CMakeLists.txt]
indent_size = 2

# 构建脚本与配置：2 空格，与 theme/css 现有风格一致
[*.{sh,yml,yaml,json,scss,css}]
indent_size = 2

# Quarto 章节：中文正文，2 空格缩进（列表续行更易读）
[*.{qmd,md}]
indent_size = 2

# Python 工具脚本：4 空格（Black 默认）
[*.py]
indent_size = 4

# Makefile 类产物必须用制表符
[Makefile]
indent_style = tab
