#===------------------------------------------------------------------------===#
# .clang-tidy - C++ 静态检查与命名规则
#===------------------------------------------------------------------------===#
---
Checks:
  - bugprone-*
  - cppcoreguidelines-*
  - misc-*
  - modernize-*
  - performance-*
  - portability-*
  - readability-*
  - google-build-using-namespace
  - google-global-names-in-headers
  - google-explicit-constructor
  # 关闭 bugprone-easily-swappable-parameters：
  # 行与列类型相同，这项误报多于真问题。
  - "-bugprone-easily-swappable-parameters"
  # 关闭 modernize-use-trailing-return-type：函数保持前置返回类型。
  - "-modernize-use-trailing-return-type"
  # 关闭 readability-identifier-length：row、col 是坐标和循环的正常短名。
  - "-readability-identifier-length"
  # 关闭 readability-magic-numbers：尺寸常量集中定义，不逐个字面量报警。
  - "-readability-magic-numbers"
  # 关闭 portability-avoid-pragma-once：头文件使用 #pragma once。
  - "-portability-avoid-pragma-once"
CheckOptions:
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: CamelCase
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  # 局部常量不是全程固定的 k 常量，避免误套 ConstantCase。
  - key: readability-identifier-naming.LocalConstantCase
    value: lower_case
  - key: readability-identifier-naming.MemberCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key: readability-identifier-naming.ConstantCase
    value: CamelCase
  - key: readability-identifier-naming.ConstantPrefix
    value: k
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantPrefix
    value: k
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
