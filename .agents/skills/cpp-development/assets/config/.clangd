#===------------------------------------------------------------------------===#
# .clangd - 编辑器语言服务配置
#===------------------------------------------------------------------------===#
CompileFlags:
  # 构建后从 build/compile_commands.json 读取真实编译参数。
  CompilationDatabase: build
  Add:
    # 未生成编译数据库时按 C++20 解析，与目标的 cxx_std_20 一致。
    - -std=c++20
    # 未生成编译数据库时仍用 libc++，与 CMake 的 -stdlib=libc++ 相同。
    - -stdlib=libc++
    # 未生成编译数据库时打开 -Wall，与目标编译选项一致。
    - -Wall
    # 未生成编译数据库时打开 -Wextra，与目标编译选项一致。
    - -Wextra
    # 未生成编译数据库时警告即错误，与目标编译选项一致。
    - -Werror
    # 未构建时解析规则库头文件。复制进阶段目录后按该阶段增删。
    - -Itic_tac_toe/include

Diagnostics:
  # 补上 clangd 默认未开的命名与 google 检查，与同目录 .clang-tidy 一致。
  ClangTidy:
    Add:
      - readability-identifier-naming
      - google-build-using-namespace
      - google-global-names-in-headers
      - google-explicit-constructor
  # 只压制首次未构建时找不到头文件的噪音；构建后以编译数据库为准。
  Suppress:
    - pp_file_not_found
